# PoC-only runtime for jinaai/jina-reranker-v3-GGUF:Q8_0.
# The upstream model requires llama-embedding and llama-tokenize from Hanxiao's
# fork because its external projector/listwise path is not supported by the
# standard llama.cpp reranking server.
ARG CUDA_VERSION=12.4.1

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG LLAMA_CPP_REVISION=96d58cc68ee4d59804b17ceeb3c46541e2d2a05e
ARG CUDA_ARCHITECTURES=75

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN git init /src/llama.cpp \
    && cd /src/llama.cpp \
    && git remote add origin https://github.com/hanxiao/llama.cpp.git \
    && git fetch --depth 1 origin "${LLAMA_CPP_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
        -DGGML_CUDA=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DLLAMA_CURL=OFF \
    && cmake --build build --config Release --parallel --target \
        llama-embedding \
        llama-tokenize


FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        fastapi==0.116.1 \
        huggingface-hub==0.34.4 \
        numpy==2.2.6 \
        pydantic==2.11.7 \
        safetensors==0.5.3 \
        tokenizers==0.21.4 \
        "uvicorn[standard]==0.35.0"

COPY --from=builder /src/llama.cpp/build/bin/llama-embedding /usr/local/bin/llama-embedding
COPY --from=builder /src/llama.cpp/build/bin/llama-tokenize /usr/local/bin/llama-tokenize
COPY infra/jina_reranker/server.py /app/server.py

ENV PYTHONUNBUFFERED=1 \
    JINA_MODEL_CACHE=/models

WORKDIR /app

EXPOSE 8080

CMD ["python3", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
