# Copy this file to .env and replace the secrets before starting the stack.
DB_PASSWORD=replace-with-a-strong-password
ADMIN_API_KEY=replace-with-a-random-admin-key

# Optional integrations and Compose substitutions
PHOENIX_PROJECT_NAME=hkpl-rag
HF_TOKEN=

# Runtime GLiGuard placement. The selected physical GPU is exposed to the
# agent as container-local cuda:0. Use SAFETY_DEVICE=cpu only for development.
SAFETY_GPU_ID=0
SAFETY_DEVICE=cuda:0

# Exact Jina Reranker v3 GGUF Q8_0 experiment. RTX 2080 Ti uses CUDA compute
# capability 7.5. These values are read only when the Jina Compose override is
# included; the normal stack continues to use Qwen.
JINA_RERANKER_GPU_ID=0
JINA_CUDA_ARCHITECTURES=75
# Pinned littlewine/llama.cpp revision required by Jina Reranker v3.5 GGUF.
JINA_V35_LLAMA_CPP_REVISION=0278d8362d78c5de291bc03b76016f7f74b2ab77

# Jina v5 embedding A/B experiment. VECTOR_TABLE is a LlamaIndex collection
# name; PostgreSQL stores it physically with the data_ prefix.
JINA_EMBEDDING_GPU_ID=0
JINA_EMBEDDING_VECTOR_TABLE=hkpl_knowledge_hybrid_jina_v5
