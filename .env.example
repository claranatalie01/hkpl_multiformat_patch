# Copy this file to .env and replace the secrets before starting the stack.
DB_PASSWORD=replace-with-a-strong-password
ADMIN_API_KEY=replace-with-a-random-admin-key

# Optional integrations and Compose substitutions
PHOENIX_PROJECT_NAME=hkpl-rag
HF_TOKEN=

# Runtime GLiGuard placement. The selected physical GPU is exposed to the
# agent as container-local cuda:0. Use SAFETY_DEVICE=cpu only for development.
SAFETY_GPU_ID=0
SAFETY_DEVICE=cuda:0

# Active retrieval corpus. Use hkpl_knowledge_hybrid only for the separately
# built and validated hybrid experiment described in docs/ingestion.md.
VECTOR_TABLE=hkpl_knowledge
# Temporary database table used while a generated benchmark awaits review.
EVALUATION_CANDIDATE_TABLE=evaluation_dataset_100
# Reviewed benchmark table populated by the promotion workflow.
EVALUATION_ACTIVE_TABLE=evaluation_dataset
TEXT_SEARCH_CONFIG=english
# Low-latency hybrid profile. Dense, full-text, and trigram candidates are
# fused down to ten chunks before the reranker selects the final five.
SIMILARITY_TOP_K=10
DENSE_TOP_K=10
LEXICAL_TOP_K=10
FUSION_TOP_K=10
RRF_K=60
RERANK_TOP_N=5
RERANKER_THRESHOLD=0.30
MAX_CONTEXT_TOKENS=4000
ANSWER_MAX_TOKENS=256

# Generation server limits. Ordinary RAG requests disable thinking and use
# ANSWER_MAX_TOKENS; the larger global cap supports evaluator responses.
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=2048
